# Maintainer: Onur Baydas <onurbaydas1@gmail.com>
pkgname=virtomir-bin
pkgver=1.0.0
pkgrel=1
pkgdesc="A Detailed Control Deck for Virtual Environments (KVM / QEMU / libvirt)"
arch=('x86_64' 'aarch64')
url="https://github.com/onurbaydas/VirtoMir"
license=('AGPL-3.0-or-later')
depends=('libvirt' 'qemu-base' 'pam')
optdepends=(
    'ipmitool: for IPMI BMC host fencing'
    'restic: for encrypted off-site backups'
    'zfs-utils: for ZFS pools and ZFS replication'
)
provides=('virtomir')
conflicts=('virtomir')
backup=('etc/pam.d/virtomir')

source_x86_64=("${pkgname}-${pkgver}-x86_64.tar.gz::https://github.com/onurbaydas/VirtoMir/releases/download/v${pkgver}/virtomir_v${pkgver}_linux_amd64.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64.tar.gz::https://github.com/onurbaydas/VirtoMir/releases/download/v${pkgver}/virtomir_v${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    local goarch=amd64
    [ "${CARCH}" = aarch64 ] && goarch=arm64
    cd "${srcdir}/virtomir_v${pkgver}_linux_${goarch}"

    install -Dm755 virtomird "${pkgdir}/usr/bin/virtomird"
    # The tarball's unit is for install.sh (/usr/local/bin); the package lives in /usr/bin.
    sed 's|/usr/local/bin/virtomird|/usr/bin/virtomird|' virtomird.service |
        install -Dm644 /dev/stdin "${pkgdir}/usr/lib/systemd/system/virtomird.service"
    install -Dm644 virtomir.pam "${pkgdir}/etc/pam.d/virtomir"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
