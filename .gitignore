# --- AI memory: local-only (project notes, transcripts, secrets); never published ---
.ai/

# --- Secrets / env ---
.env
.env.*
!.env.example
# the online demo's build mode (no secrets: it only turns the pretend API on)
!web/.env.demo
*.pem
*.key

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
__pycache__/
*.pyc
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Build outputs / deps ---
node_modules/
dist/
# web/dist is embedded into virtomird; keep only the placeholder so `go build` works on a fresh clone
!web/dist/
web/dist/*
!web/dist/.gitkeep
# the online demo (npm run build:demo), published to GitHub Pages, never embedded
web/dist-demo/
build/
bin/
out/
coverage/
*.log
# Windows daemon binary (build artifact)
virtomird.exe

# --- graphify: local code knowledge graph (rebuilt by 'graphify update .') ---
graphify-out/
