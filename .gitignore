# --- AI memory: local-only (project notes, transcripts, secrets); never published ---
.ai/

# --- Secrets / env ---
.env
.env.*
!.env.example
*.pem
*.key

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Build outputs / deps ---
node_modules/
dist/
# web/dist is embedded into virtomird; keep only the placeholder so `go build` works on a fresh clone
!web/dist/
web/dist/*
!web/dist/.gitkeep
build/
bin/
out/
coverage/
*.log
